<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>FlashOWare.CodeAnalysis.Build</PackageId>
    <Title>FlashOWare.CodeAnalysis.Build</Title>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\build\FlashOWare.CodeAnalysis.Build.props" Pack="true" PackagePath="build/" />
    <None Include="..\build\FlashOWare.CodeAnalysis.Build.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
